{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/fallow.schema.json",
  "entry": [
    "frontend/*.jsx",
    "static/app.js",
    "static/bootstrap.js",
    "frontend/landing.js",
    "frontend/landing_scroll_perf.js",
    "static/*.css",
    "scripts/*.mjs",
    "tests/*.js",
    "playwright.config.js"
  ],
  "ignorePatterns": [
    "node_modules/**",
    "venv/**",
    "convex/_generated/**",
    "fonts/**",
    "FontshareKit-*/**",
    "static/convex_auth_test.js",
    "static/convex_bridge.js",
    "static/landing_hero.js",
    "static/landing.js"
  ],
  "ignoreUnresolvedImports": [
    "convex/_generated/server.d.ts"
  ],
  "duplicates": {
    "mode": "semantic",
    "ignoreImports": true,
    "ignore": [
      "static/convex_auth_test.js",
      "static/convex_bridge.js",
      "static/landing_hero.js",
      "frontend/landing.js",
      "venv/**"
    ]
  },
  "health": {
    "ignore": [
      "static/convex_auth_test.js",
      "static/convex_bridge.js",
      "static/landing_hero.js",
      "frontend/components/DotField.jsx",
      "frontend/components/LiquidChrome.jsx",
      "frontend/landing_hero.jsx",
      "frontend/landing.js",
      "venv/**"
    ]
  }
}
